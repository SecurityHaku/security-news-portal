# このファイルを .env にコピーして値を埋める（.env はコミットされない）
# ローカルでのメール送信テスト用。GitHub Actions では Secrets に同名で登録する。

# --- SMTP 設定（Gmail の例） ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
# Gmail は「アプリパスワード」を発行して使う（通常のログインパスワードは不可）
# https://myaccount.google.com/apppasswords
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=your-account@gmail.com
SMTP_STARTTLS=true

# --- 宛先（任意） ---
# 設定するとファイル(メールアドレス.txt)より優先される。カンマ / 改行区切りで複数可。
# Actions では必須（メールアドレス.txt はコミットされないため）。
REPORT_RECIPIENTS=

# --- 対象月の上書き（任意） ---
# 空欄なら「前月」。Actions の workflow_dispatch から渡す用途。
REPORT_MONTH=

# --- 日本語化・着眼点（enrich.py）---
# 既定は無料エンジン（MyMemory翻訳 + ルールベースの着眼点）。キー等は不要。
# MyMemory 匿名枠は 1日約5000語。メールを設定すると 1日50000語に拡大（任意）。
MYMEMORY_EMAIL=
# 概要訳を付ける範囲（各月の注目度 上位N位。既定: 20）
#   ※ 着眼点は「各月・各カテゴリで注目度1位の記事（最大7件）」に自動で付くため設定不要。
ENRICH_FREE_SUMMARY_TOP_N=20

# --- 任意: LLMエンジン（Claude API）にアップグレード ---
# ANTHROPIC_API_KEY を設定すると enrich.py は自動で llm エンジンに切替。
# 翻訳品質が上がり、着眼点は「一流アナリスト視点の見解」になります（従量課金）。
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ENRICH_TRANSLATE_MODEL=claude-haiku-4-5
ENRICH_ANALYSIS_MODEL=claude-sonnet-5
